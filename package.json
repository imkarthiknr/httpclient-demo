{
  "name": "httpclient-demo",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c blue,magenta \"npm run api\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "start:web": "ng serve",
    "api": "node mock-api/serve.mjs",
    "api:reset": "node mock-api/serve.mjs --reset",
    "test:watch": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.4",
    "jsdom": "^28.0.0",
    "json-server": "1.0.0-beta.15",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "description": "Angular HttpClient patterns: typed requests, search & pagination, CRUD, interceptors, retries and testing, against a json-server mock API.",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imkarthiknr/httpclient-demo.git"
  },
  "author": "Karthik N R (https://github.com/imkarthiknr)",
  "license": "MIT"
}
